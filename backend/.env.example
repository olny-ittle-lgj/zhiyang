SECRET_KEY=replace-with-a-long-random-string
DATABASE_PATH=./data/zhiyan.db
UPLOAD_DIR=./data/uploads
FRONTEND_ORIGIN=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional HTTP proxy for environments where direct DeepSeek access is blocked.
# Example: DEEPSEEK_PROXY_URL=http://127.0.0.1:7890
DEEPSEEK_PROXY_URL=

# PRD-standard BGE-M3 embedding runtime. The first vector request downloads this model.
# Local 8-bit ONNX model generated by the setup step.
BGE_M3_MODEL=../data/bge-m3-int8
BGE_M3_DEVICE=cpu
BGE_M3_BACKEND=onnx
BGE_M3_ONNX_FILE=onnx/model_qint8_avx2.onnx
HF_HOME=%TEMP%\zhiyan-huggingface

# Vector matching: use MILVUS_URI for the standalone Docker service; leave blank to use Milvus Lite.
MILVUS_ENABLED=true
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_PATH=%TEMP%\zhiyan-milvus-standard.db
MILVUS_INDEX_TYPE=FLAT

# Fetch MCP - leave URL blank to disable URL extraction
FETCH_MCP_URL=
FETCH_MCP_TRANSPORT=auto
FETCH_MCP_TOKEN=
FETCH_MCP_TOOL=fetch
FETCH_MCP_TIMEOUT=30
FETCH_MCP_MAX_CHARS=100000
FETCH_DIRECT_TIMEOUT=15

# Local image OCR limits
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=40000000
VIDEO_ANALYSIS_TIMEOUT=45
VIDEO_OCR_FRAME_COUNT=3
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_MAX_PIXELS=8294400
# Optional absolute path when FFmpeg is managed outside imageio-ffmpeg
FFMPEG_BINARY=

# Legacy SSE variable (used only when FETCH_MCP_URL is empty)
FETCH_MCP_SSE_URL=
